def detect_leads():
    return [lead for lead in KNOWN_LEADS if shutil.which(lead[0])]


class Talk:
    """Questions and messages in the chosen language."""

    def __init__(self, lang="pt"):
        self.lang = lang

    def t(self, key, **values):
        text = TEXT[self.lang][key]
        return text.format(**values) if values else text

    def say(self, key, **values):
        print(self.t(key, **values))

    def ask(self, prompt, default=""):
        try:
            answer = input(f"{prompt}{f' [{default}]' if default else ''}: ").strip()
        except EOFError:
            answer = ""
        return answer or default

    def confirm(self, prompt, default=True, why=None):
        if why:
            print(f"\n{why}")
        yes, no = self.t("yes"), self.t("no")
        answer = self.ask(f"{prompt} {self.t('yes_no')}", yes if default else no).lower()
        return answer.startswith((yes, "s", "y"))

    def choose(self, prompt, labels, default, multi=False, why=None):
        """Numbered menu. Returns 0-based indices; the default holds 1-based numbers."""
        print(f"\n{prompt}")
        if why:
            print(why)
        for number, label in enumerate(labels, 1):
            print(f"  {number}) {label}")
        hint = self.t("choose_many" if multi else "choose_one")
        for _ in range(5):
            raw = self.ask(hint, ",".join(str(d) for d in default))
            try:
                picks = [int(part) - 1 for part in raw.replace(" ", "").split(",") if part]
            except ValueError:
                picks = []
            if picks and all(0 <= p < len(labels) for p in picks) and (multi or len(picks) == 1):
                return list(dict.fromkeys(picks))
            self.say("invalid")
        return [d - 1 for d in default]


def pick_language():
    env = (os.environ.get("LC_ALL") or os.environ.get("LANG") or "").lower()
    talk = Talk("pt")
    choice = talk.choose("Idioma / Language", ["Português", "English"], [2 if env.startswith("en") else 1])
    return Talk("en" if choice == [1] else "pt")


def marketplace():
    return os.environ.get("PIRLO_MARKETPLACE") or "isaiasaltoe/pirlo"


def spec_label(spec, talk):
    if spec["cli"] == "native":
        return talk.t("native")
    return " ".join(x for x in (spec["cli"], spec.get("model"), spec.get("effort")) if x)


def spec_for_model(cli, model):
    return {"cli": cli, "model": model, "effort": "medium"} if cli in ("codex", "claude") \
        else {"cli": cli, "model": model}


def step(argv, talk, cwd=None):
    print("  $ " + " ".join(str(a) for a in argv))
    code, out = run_quiet(argv, timeout=300, cwd=cwd)
    if code != 0:
        lines = [line.strip() for line in out.splitlines() if line.strip()]
        errors = [line for line in lines if re.match(r"(error|fatal)\b", line, re.IGNORECASE)]
        useful = [line for line in lines if not re.match(r"\d+: |at |stack backtrace", line, re.IGNORECASE)]
        talk.say("failed", tail=(errors or useful or ["?"])[0][:300])
    return code == 0


def install_claude(scope, root, talk):
    exe = shutil.which("claude")
    if not exe:
        talk.say("skip", name="Claude Code")
        return
    if step([exe, "plugin", "install", "pirlo", "--marketplace", marketplace(), "--scope", scope],
            talk, cwd=str(root) if scope == "local" else None):
        talk.say("plugin_ok", name="Claude Code")


def install_codex(talk, rules):
    exe = shutil.which("codex")
    if not exe:
        talk.say("skip", name="Codex")
        return
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    home.mkdir(parents=True, exist_ok=True)  # Codex refuses a CODEX_HOME that does not exist
    step([exe, "plugin", "marketplace", "add", marketplace()], talk)
    if step([exe, "plugin", "add", "pirlo@pirlo"], talk):
        talk.say("plugin_ok", name="Codex")
    if rules:
        path = home / "rules" / "pirlo.rules"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(CODEX_RULES, encoding="utf-8")
        talk.say("rules_ok", path=path)


def install_skills(dest, talk):
    dest = Path(dest).expanduser()
    local = Path(__file__).resolve().parent.parent / "portable" / "skills"
    for name in SKILL_NAMES:
        target = dest / name / "SKILL.md"
        target.parent.mkdir(parents=True, exist_ok=True)
        source = local / name / "SKILL.md"
        if source.is_file():
            shutil.copyfile(source, target)
        else:
            import urllib.request
            with urllib.request.urlopen(f"{RAW_URL}portable/skills/{name}/SKILL.md", timeout=30) as reply:
                target.write_bytes(reply.read())
    talk.say("skills_ok", path=dest)


def write_instructions(root, name, talk):
    path = Path(root) / name
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    if re.search(r"^# pirlo\s*$", text, re.MULTILINE):
        talk.say("agents_has", file=name)
        return
    tracked = run_quiet(["git", "-C", str(root), "ls-files", "--error-unmatch", name])[0] == 0
    if tracked and not talk.confirm(talk.t("agents_tracked", file=name), False):
        talk.say("agents_skip")
        return
    with path.open("a", encoding="utf-8") as handle:
        handle.write(("\n" if text and not text.endswith("\n\n") else "") + LEADER_INSTRUCTIONS)
    if tracked:
        talk.say("agents_ok", file=name)
        return
    exclude = Path(root) / ".git" / "info" / "exclude"
    if exclude.parent.is_dir():
        current = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
        if f"/{name}" not in current.split():
            with exclude.open("a", encoding="utf-8") as handle:
                handle.write(("\n" if current and not current.endswith("\n") else "") + f"/{name}\n")
    talk.say("agents_excluded", file=name)


def install_other(scope, root, talk, files):
    if scope == "user":
        folder = talk.ask(talk.t("skills_q"))
        if folder:
            install_skills(folder, talk)
        talk.say("global_file")
        return
    for name in files:
        write_instructions(root, name, talk)


def cmd_setup(args):
    talk = pick_language()
    root = repo_root(os.getcwd())
    in_repo = (Path(root) / ".git").exists()
    config, _, _ = load_config(root)
    print(f"\n{talk.t('title')}\n")
    talk.say("detecting")
    clis = detect(config)
    by_name = {c["cli"]: c for c in clis}
    for c in clis:
        state = talk.t("not_installed") if not c["installed"] else talk.t(
            {True: "logged_in", False: "logged_out", None: "installed"}[c["loggedIn"]])
        print(f"  {c['cli']:7} {state}")
    found = detect_leads()
    extra = [label for name, label, _ in found if name not in by_name]
    if extra:
        print(f"  + {', '.join(extra)}")

    leads = [(name, label, file) for name, label, file in found]
    leads.append(("other", talk.t("other"), "AGENTS.md"))
    default = [n for n, (name, _, _) in enumerate(leads, 1) if name in ("claude", "codex")] or [1]
    picked = talk.choose(talk.t("leaders_q"), [label for _, label, _ in leads], default, multi=True,
                         why=talk.t("leaders_why"))
    chosen = [leads[i] for i in picked]
    names = [name for name, _, _ in chosen]

    if in_repo:
        picked = talk.choose(talk.t("scope_q"), [talk.t("scope_user"), talk.t("scope_local", root=root)],
                             [1], why=talk.t("scope_why"))
        scope = "user" if picked == [0] else "local"
    else:
        print()
        talk.say("no_repo")
        scope = "user"

    proposal, notes = propose(clis, [n for n in names if n != "other"])
    for note in notes:
        print()
        talk.say("note", note=note)
    options = proposal["workers"]
    if not options:
        print()
        talk.say("no_worker")
        return 1
    order = talk.choose(talk.t("worker_q"), [spec_label(spec, talk) for spec in options],
                        list(range(1, len(options) + 1)), multi=True, why=talk.t("worker_why"))
    workers = [options[i] for i in order]
    if any(by_name.get(w["cli"], {}).get("models") for w in workers) and \
            talk.confirm(f"\n{talk.t('models_q')}", False):
        for n, spec in enumerate(workers):
            models = by_name.get(spec["cli"], {}).get("models") or []
            if spec["cli"] == "native" or not models:
                continue
            current = models.index(spec["model"]) + 1 if spec.get("model") in models else 1
            pick_model = talk.choose(talk.t("model_q", name=spec["cli"]), models, [current])[0]
            workers[n] = spec_for_model(spec["cli"], models[pick_model])

    allow = "claude" in names and talk.confirm(talk.t("allow_q"), True, why=talk.t("allow_why"))
    rules = "codex" in names and talk.confirm(talk.t("rules_q"), True, why=talk.t("rules_why"))

    yes_no = lambda value: talk.t("v_yes" if value else "v_no")
    print()
    talk.say("summary")
    talk.say("s_leaders", v=", ".join(label for _, label, _ in chosen))
    talk.say("s_scope", v=talk.t("s_global") if scope == "user" else talk.t("s_local", root=root))
    talk.say("s_worker", v=" → ".join(spec_label(spec, talk).split(":")[0] for spec in workers))
    if "claude" in names:
        talk.say("s_allow", v=yes_no(allow))
    if "codex" in names:
        talk.say("s_rules", v=yes_no(rules))
    if not talk.confirm(f"\n{talk.t('apply_q')}", True):
        talk.say("nothing")
        return 1

    print()
    path = save_config({"version": 3, "leaders": names, "language": talk.lang, "workers": workers},
                       scope, root)
    talk.say("saved", path=path)
    if "claude" in names:
        print("\nClaude Code:")
        install_claude(scope, root, talk)
        if allow:
            try:
                print("  " + allow_rules())
            except PirloError as error:
                print(f"  {error}")
    if "codex" in names:
        print("\nCodex:")
        install_codex(talk, rules)
    files = list(dict.fromkeys(file for name, _, file in chosen if file))
    if files:
        print(f"\n{talk.t('other_heading')}")
        install_other(scope, root, talk, files)
    print()
    talk.say("done")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="pirlo", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"pirlo {VERSION}")
    sub = parser.add_subparsers(dest="command_name", required=True)

    def worker_parser(name, help_text):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("--cwd")
        return p

    p = worker_parser("ask", "a worker reads or searches and answers (read-only)")
    p.add_argument("task", nargs="*")
    p.set_defaults(func=cmd_ask)
    p = worker_parser("edit", "a worker makes a mechanical edit")
    p.add_argument("task", nargs="*")
    p.set_defaults(func=cmd_edit)
    p = worker_parser("digest", "a worker digests long command output piped in")
    p.add_argument("--task", dest="task", action="append", help="what to look for in the output")
    p.add_argument("--label", help="the command that produced the output, for the reply")
    p.set_defaults(func=cmd_digest)
    p = sub.add_parser("detect", help="find installed and logged-in CLIs and their models")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_detect)
    p = sub.add_parser("propose", help="propose a worker from what is installed")
    p.add_argument("--leader", default="claude", help="the CLIs you lead from, comma-separated: claude,codex,agy...")
    p.set_defaults(func=cmd_propose)
    p = sub.add_parser("setup", help="interactive setup in the terminal")
    p.set_defaults(func=cmd_setup)
    p = sub.add_parser("save", help="save a config read from stdin")
    p.add_argument("--scope", choices=("user", "local"), required=True)
    p.set_defaults(func=cmd_save)
    p = sub.add_parser("show", help="show the config in effect here")
    p.set_defaults(func=cmd_show)
    p = sub.add_parser("savings", help="estimate the tokens the lead did not read")
    p.add_argument("--days", type=int, default=30, help="0 for all time")
    p.add_argument("--here", action="store_true", help="only this repository")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_savings)
    p = sub.add_parser("hook", help="SessionStart hook for Claude Code")
    p.add_argument("--claude-code", action="store_true", help="the lead is Claude Code")
    p.add_argument("--stop-failure", action="store_true", help="StopFailure hook: Claude hit its limit")
    p.set_defaults(func=cmd_hook)
    p = sub.add_parser("passe", help="hand unfinished work over to another AI")
    p.add_argument("--lead", help="the AI that stopped: claude, codex, agy...")
    p.add_argument("--reason", help="why it stopped")
    p.add_argument("--transcript", help="the session file to summarize")
    p.add_argument("--cwd")
    p.add_argument("--done", action="store_true", help="close the passe after taking the work over")
    p.set_defaults(func=cmd_passe)
    p = sub.add_parser("allow", help="let Claude Code run pirlo's read-only commands unprompted")
    p.set_defaults(func=cmd_allow)
    p = sub.add_parser("instructions", help="print the lead instructions for AGENTS.md")
    p.set_defaults(func=cmd_instructions)
    p = sub.add_parser("log", help="print the path of the usage log")
    p.set_defaults(func=cmd_log)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except PirloError as error:
        print(f"pirlo: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
